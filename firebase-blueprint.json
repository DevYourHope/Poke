{
  "entities": {
    "ShinyHunt": {
      "title": "Shiny Hunt",
      "description": "A Pokémon shiny hunting session.",
      "type": "object",
      "properties": {
        "pokemonId": { "type": "string" },
        "pokemonName": { "type": "string" },
        "count": { "type": "number" },
        "method": { "type": "string" },
        "status": { "type": "string", "enum": ["hunting", "caught"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["pokemonId", "pokemonName", "count", "userId"]
    },
    "PokedexEntry": {
      "title": "Pokédex Entry",
      "description": "A Pokémon caught in the Pokédex.",
      "type": "object",
      "properties": {
        "pokemonId": { "type": "string" },
        "pokemonName": { "type": "string" },
        "caughtAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["pokemonId", "pokemonName", "userId"]
    },
    "Team": {
      "title": "Team",
      "description": "A Pokémon team.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "userId": { "type": "string" }
      },
      "required": ["name", "members", "userId"]
    },
    "CustomGame": {
      "title": "Custom Game",
      "description": "A custom Pokémon game version.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "region": { "type": "string" },
        "progress": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["name", "userId"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User's personal profile data.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "favoritePokemonId": { "type": "number" },
        "trainerTitle": { "type": "string" },
        "bio": { "type": "string" },
        "joinDate": { "type": "number" },
        "themeColor": { "type": "string" }
      },
      "required": ["displayName", "joinDate"]
    }
  },
  "firestore": {
    "/users/{userId}/profile/data": {
      "schema": "UserProfile",
      "description": "User's personal profile data."
    },
    "/users/{userId}/shinyHunts/{huntId}": {
      "schema": "ShinyHunt",
      "description": "User's shiny hunting sessions."
    },
    "/users/{userId}/pokedexes/{entryId}": {
      "schema": "PokedexEntry",
      "description": "User's Pokédex entries."
    },
    "/users/{userId}/teams/{teamId}": {
      "schema": "Team",
      "description": "User's Pokémon teams."
    },
    "/users/{userId}/customGames/{gameId}": {
      "schema": "CustomGame",
      "description": "User's custom game versions."
    }
  }
}
